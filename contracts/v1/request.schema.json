{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qf.agent/v1/request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "requestId",
    "loop",
    "intent",
    "workspace",
    "allowedPaths",
    "allowedTools",
    "provider",
    "deadlineMs",
    "maxRepairAttempts",
    "verifier"
  ],
  "properties": {
    "protocolVersion": {
      "const": "qf.agent/v1"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[\\w-]{1,100}$"
    },
    "loop": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "enum": [
            "synthetic-sdd",
            "sdd-pipeline"
          ]
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32000
    },
    "workspace": {
      "type": "string",
      "description": "Absolute trusted local directory"
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowedTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provider": {
      "type": "object",
      "required": [
        "kind",
        "model",
        "payerScope"
      ],
      "properties": {
        "kind": {
          "enum": [
            "claude",
            "codex",
            "openrouter",
            "caller"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "payerScope": {
          "enum": [
            "local-cli",
            "local-byok"
          ]
        },
        "executable": {
          "type": "string"
        },
        "keyRef": {
          "type": "string"
        },
        "agent": {
          "enum": [
            "codex",
            "claude"
          ]
        }
      }
    },
    "deadlineMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "maxRepairAttempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "verifier": {
      "type": "object",
      "required": [
        "command",
        "args"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "hash",
        "decision"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision": {
          "enum": [
            "approve",
            "reject"
          ]
        }
      }
    },
    "resumeRunId": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "maxCostUsd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maxCallCostUsd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "specification": {
      "$ref": "#/$defs/specification"
    },
    "specChange": {
      "type": "object",
      "required": [
        "expectedHash",
        "expectedRevision",
        "reason"
      ],
      "properties": {
        "expectedHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "specification": {
          "$ref": "#/$defs/specification"
        }
      }
    },
    "clarification": {
      "type": "object",
      "required": [
        "hash",
        "answers"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "id",
              "answer"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        }
      }
    },
    "maxInferenceJobs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "inferenceTtlMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "cancelInference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "hash"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[a-f0-9-]{36}$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "inferenceReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "hash",
        "output"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[a-f0-9-]{36}$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output": {
          "type": "object",
          "description": "At most 64000 UTF-8 JSON bytes; output shape must match the persisted job."
        }
      }
    }
  },
  "description": "Structural schema. validateRequest additionally enforces local path, verifier authorization, provider pairing and bound relations.",
  "$defs": {
    "specification": {
      "type": "object",
      "required": [
        "summary",
        "criteria",
        "plan"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "plan": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  }
}
