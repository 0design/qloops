{
  "name": "qloops",
  "version": "0.2.0-core.13",
  "license": "MIT",
  "description": "Run a QFactory loop from a YAML manifest. No database, no server, no build step.",
  "type": "module",
  "bin": {
    "qloops": "bin/qloops.mjs",
    "qloop": "bin/qloop.mjs"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "catalog": "node -e \"import('./src/catalog.mjs').then(async({buildCatalog})=>{const{writeFileSync}=await import('node:fs');writeFileSync('catalog.json',JSON.stringify(buildCatalog('loops',{examplesDir:'examples'}),null,2)+'\\n')})\"",
    "proof": "node scripts/record-proof.mjs --all",
    "test:package": "node scripts/test-package.mjs && node scripts/test-content-package.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "launchd/",
    "examples/",
    "LICENSE",
    "CONTRIBUTING.md",
    "README.md",
    "SPEC-MANIFEST.md",
    "contracts/",
    "docs/codex.md"
  ],
  "dependencies": {},
  "author": "Oleg Kukharuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0design/qloops.git"
  },
  "bugs": {
    "url": "https://github.com/0design/qloops/issues"
  },
  "homepage": "https://github.com/0design/qloops#readme",
  "exports": {
    ".": "./src/index.mjs",
    "./src/*": "./src/*",
    "./contracts/*": "./contracts/*",
    "./package.json": "./package.json"
  }
}
