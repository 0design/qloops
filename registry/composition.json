      "id": "api-request",
      "name": "API request",
      "kind": "step",
      "description": "An outgoing request. SPEC-MANIFEST.md §5.3. Without body, the last successful output is sent in an envelope {runId, templateId, payload}. A loop may end here. This is a complete loop, not an unfinished one. SPEC does not enumerate response fields.",
      "input": {
        "url": {
          "type": "string",
          "required": true,
          "notes": "templated. SPEC-MANIFEST.md §5.3."
        },
        "method": {
          "type": "string",
          "required": false,
          "notes": "GET/POST/PUT/PATCH/DELETE. Default POST."
        },
        "body": {
          "type": "string",
          "required": false,
          "notes": "JSON string or text. templated, deeply."
        },
        "headers": {
          "type": "string",
          "required": false,
          "notes": "JSON string. templated."
        },
        "expect": {
          "type": "string",
          "required": false,
          "notes": "2xx | any. Default 2xx."
        },
        "timeoutSec": {
          "type": "number",
          "required": false,
          "notes": "Default 30."
        }
      },
      "output": {
        "response": {
          "type": "object",
          "notes": "SPEC-MANIFEST.md §5.3 does not list output fields. The step performs the request; when it is last, the loop is complete."
